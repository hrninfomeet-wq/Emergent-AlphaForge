# Root context allowlist for identical, secret-free build source snapshots.
**
!backend/
!backend/app/
!backend/app/**
!backend/scripts/
!backend/scripts/*.py
!backend/server.py
!backend/requirements.txt
!backend/Dockerfile
!frontend/
!frontend/src/
!frontend/src/**
!frontend/public/
!frontend/public/**
!frontend/plugins/
!frontend/plugins/**
!frontend/package.json
!frontend/yarn.lock
!frontend/Dockerfile
!frontend/nginx.conf
!frontend/craco.config.js
!frontend/jsconfig.json
!frontend/postcss.config.js
!frontend/tailwind.config.js
!frontend/components.json
!docker-compose.yml
!start-app.bat
!.dockerignore
# Final exclusions override source-tree inclusions, including nested secrets.
**/.env*
**/.git
.git
**/node_modules
**/__pycache__
**/.venv
**/venv
**/.pytest_cache
**/*.pyc
**/*.pyo
**/*.key
**/*.pem
**/token*
**/*credentials*
**/*secret*
**/*.csv
**/*.parquet
**/*.db
**/*.sqlite*
**/*.bson
**/*.jsonl
**/*.log
**/*.zip
**/*.gz
**/build-manifest.json
